; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Pile Down"
run/main_scene="res://resources/scenes/Main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://resources/sprites/branding/game-icon.png"

[display]

window/size/viewport_width=256
window/size/viewport_height=320
window/size/window_width_override=512
window/size/window_height_override=640
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom_font="res://resources/fonts/VCR_OSD_MONO_1.001.ttf"

[input_devices]

pointing/emulate_mouse_from_touch=false

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.968627, 0.964706, 0.94902, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[shader_globals]

background_viewport_size={
"type": "vec2",
"value": Vector2(256, 320)
}
background_reference_size={
"type": "vec2",
"value": Vector2(256, 320)
}
background_color_a={
"type": "color",
"value": Color(0.9686, 0.9647, 0.9529, 1)
}
background_color_b={
"type": "color",
"value": Color(0.31, 0.49, 0.72, 0.16)
}
background_intensity={
"type": "float",
"value": 1.0
}
background_pixelated={
"type": "float",
"value": 1.0
}
background_pixel_size={
"type": "float",
"value": 2.0
}
