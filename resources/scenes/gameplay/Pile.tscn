[sub_resource type="Shader" id="TileColorShader"]
code = "shader_type canvas_item;

uniform vec4 tile_color : source_color = vec4(0.0, 1.0, 0.0, 1.0);
uniform float completion_morph : hint_range(0.0, 1.0) = 0.0;
uniform vec4 morph_edge_color : source_color = vec4(0.31, 0.64, 0.63, 1.0);
uniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear;

float pixel_noise(vec2 pixel) {
	return fract(sin(dot(pixel, vec2(12.9898, 78.233))) * 43758.5453);
}

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	bool is_green = source.g > 0.65 && source.g > source.r * 1.6 && source.g > source.b * 1.6;
	vec4 colored_tile = is_green ? vec4(tile_color.rgb, source.a * tile_color.a) : source;
	if (completion_morph <= 0.001 || source.a <= 0.001) {
		COLOR = colored_tile;
	} else {
		vec2 centered = UV - vec2(0.5);
		float radial = clamp(length(centered) * 1.4, 0.0, 1.0);
		float noise = pixel_noise(floor(UV / TEXTURE_PIXEL_SIZE));
		float field = mix(noise, radial, 0.58);
		float morph = smoothstep(field - 0.12, field + 0.12, completion_morph);
		if (completion_morph >= 0.999) {
			morph = 1.0;
		}
		vec2 direction = normalize(centered + vec2(0.0001));
		float bend = sin(completion_morph * 3.14159265) * (1.0 - radial) * 0.009;
		vec3 background = texture(screen_texture, SCREEN_UV + direction * bend).rgb;
		vec4 merged = vec4(background, source.a);
		float edge = 1.0 - smoothstep(0.0, 0.09, abs(field - completion_morph));
		merged.rgb = mix(merged.rgb, morph_edge_color.rgb, edge * 0.32);
		COLOR = mix(colored_tile, merged, morph);
	}
}"

[sub_resource type="ShaderMaterial" id="TileColorMaterial"]
resource_local_to_scene = true
shader = SubResource("TileColorShader")
shader_parameter/tile_color = Color(0, 1, 0, 1)
shader_parameter/completion_morph = 0.0
shader_parameter/morph_edge_color = Color(0.31, 0.64, 0.63, 1)

[sub_resource type="Shader" id="RegenProgressShader"]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 1.0;
uniform vec4 progress_color : source_color = vec4(0.816, 0.631, 0.227, 1.0);

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	bool green_key = source.g > 0.6 && source.g > source.r * 1.35 && source.g > source.b * 1.35;
	if (source.a > 0.0 && green_key) {
		float angle = atan(UV.y - 0.5, UV.x - 0.5);
		float clockwise_from_top = fract((angle + 1.57079632679) / 6.28318530718);
		COLOR = clockwise_from_top <= progress ? vec4(progress_color.rgb, source.a * progress_color.a) : vec4(0.0);
	} else {
		COLOR = vec4(0.0);
	}
}"

