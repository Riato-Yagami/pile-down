[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://resources/scripts/special_rules/rules/RegenerationRing.gd" id="1"]
[ext_resource type="Texture2D" path="res://resources/materials/textures/tiles/tile-regen.tres" id="2"]

[sub_resource type="Shader" id="RegenProgressShader"]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 1.0;
uniform vec4 progress_color : source_color = vec4(0.816, 0.631, 0.227, 1.0);

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	bool green_key = source.g > 0.6 && source.g > source.r * 1.35 && source.g > source.b * 1.35;
	if (source.a > 0.0 && green_key) {
		float angle = atan(UV.y - 0.5, UV.x - 0.5);
		float clockwise_from_top = fract((angle + 1.57079632679) / 6.28318530718);
		COLOR = clockwise_from_top <= progress ? vec4(progress_color.rgb, source.a * progress_color.a) : vec4(0.0);
	} else {
		COLOR = vec4(0.0);
	}
}"

[sub_resource type="ShaderMaterial" id="RegenProgressMaterial"]
resource_local_to_scene = true
shader = SubResource("RegenProgressShader")
shader_parameter/progress = 1.0
shader_parameter/progress_color = Color(0.816, 0.631, 0.227, 1)

