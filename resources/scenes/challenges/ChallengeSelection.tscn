[ext_resource type="Texture2D" path="res://resources/materials/textures/ui/buttons/escape.tres" id="4_escape"]
[ext_resource type="Script" path="res://resources/scripts/ui/TextureHighlightButton.gd" id="5_highlight"]

[sub_resource type="Shader" id="ButtonHighlightShader"]
code = "shader_type canvas_item;

uniform vec4 base_color : source_color = vec4(0.302, 0.51, 0.761, 1.0);
uniform vec4 highlight_color : source_color = vec4(0.427, 0.655, 0.898, 1.0);

void fragment() {
	vec4 texture_color = texture(TEXTURE, UV);
	vec4 source = texture_color * COLOR;
	bool base_fill_pixel = texture_color.a > 0.0 && distance(texture_color.rgb, base_color.rgb) < 0.01;
	if (base_fill_pixel) {
		source.rgb = highlight_color.rgb;
	}
	COLOR = source;
}"

[sub_resource type="ShaderMaterial" id="ButtonHighlightMaterial"]
resource_local_to_scene = true
shader = SubResource("ButtonHighlightShader")
shader_parameter/base_color = Color(0.302, 0.51, 0.761, 1)
shader_parameter/highlight_color = Color(0.427, 0.655, 0.898, 1)

