[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://resources/scripts/special_rules/rules/FlashlightOverlay.gd" id="1"]

[sub_resource type="Shader" id="FlashlightShader"]
code = "shader_type canvas_item;

uniform vec2 light_position = vec2(128.0, 160.0);
uniform vec2 viewport_size = vec2(256.0, 320.0);
uniform float radius = 54.0;
uniform float softness = 14.0;
uniform float darkness_alpha = 0.985;

void fragment() {
	vec2 pixel_position = UV * viewport_size;
	float distance_to_light = distance(pixel_position, light_position);
	float alpha = smoothstep(radius, radius + softness, distance_to_light) * darkness_alpha;
	COLOR = vec4(0.0, 0.0, 0.0, alpha);
}"

[sub_resource type="ShaderMaterial" id="FlashlightMaterial"]
shader = SubResource("FlashlightShader")

[node name="FlashlightOverlay" type="ColorRect"]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
material = SubResource("FlashlightMaterial")
script = ExtResource("1")
darkness_alpha = 0.985
