[sub_resource type="Shader" id="TileColorShader"]
code = "shader_type canvas_item;

uniform vec4 tile_color : source_color = vec4(0.0, 1.0, 0.0, 1.0);

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	bool is_green = source.g > 0.65 && source.g > source.r * 1.6 && source.g > source.b * 1.6;
	COLOR = is_green ? vec4(tile_color.rgb, source.a * tile_color.a) : source;
}"

