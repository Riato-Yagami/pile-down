[sub_resource type="StyleBoxTexture" id="FontButtonStyle"]
texture = ExtResource("10_button")

[sub_resource type="Shader" id="ProgressionButtonHighlightShader"]
code = "shader_type canvas_item;

uniform vec4 base_color : source_color = vec4(0.302, 0.51, 0.761, 1.0);
uniform vec4 highlight_color : source_color = vec4(0.3019608, 0.50980395, 0.7607843, 1.0);

void fragment() {
	vec4 texture_color = texture(TEXTURE, UV);
	vec4 source = texture_color * COLOR;
	bool base_fill_pixel = (
		texture_color.a > 0.0
		&& distance(texture_color.rgb, base_color.rgb) < 0.01
	);
	if (base_fill_pixel) {
		source.rgb = highlight_color.rgb;
	}
	COLOR = source;
}"

[sub_resource type="ShaderMaterial" id="FontButtonHighlightMaterial"]
resource_local_to_scene = true
shader = SubResource("ProgressionButtonHighlightShader")
shader_parameter/base_color = Color(0.302, 0.51, 0.761, 1)
shader_parameter/highlight_color = Color(0.427, 0.655, 0.898, 1)

[sub_resource type="Shader" id="FontPreviewTileShader"]
code = "shader_type canvas_item;

uniform vec4 tile_color : source_color = vec4(0.302, 0.51, 0.761, 1.0);

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	bool is_green = source.g > 0.6 && source.g > source.r * 1.35 && source.g > source.b * 1.35;
	COLOR = is_green ? vec4(tile_color.rgb, source.a * tile_color.a) : source;
}
"

[sub_resource type="ShaderMaterial" id="FontPreviewTileMaterial"]
resource_local_to_scene = true
shader = SubResource("FontPreviewTileShader")
shader_parameter/tile_color = Color(0.302, 0.51, 0.761, 1)

[sub_resource type="Shader" id="LockBarHighlightShader"]
code = "shader_type canvas_item;

uniform int selected_mode = 0;
uniform vec4 highlight_color : source_color = vec4(0.427, 0.655, 0.898, 1.0);

void fragment() {
	vec4 source = texture(TEXTURE, UV) * COLOR;
	bool lock_pixel = UV.y < 0.55 && source.a > 0.0;
	bool left_selected = selected_mode == 0 || selected_mode == 2;
	bool right_selected = selected_mode == 0 || selected_mode == 1;
	if (lock_pixel && ((UV.x < 0.42 && left_selected) || (UV.x >= 0.42 && right_selected))) {
		source.rgb = highlight_color.rgb;
	}
	COLOR = source;
}"

[sub_resource type="ShaderMaterial" id="LockBarHighlightMaterial"]
resource_local_to_scene = true
shader = SubResource("LockBarHighlightShader")
shader_parameter/selected_mode = 0
shader_parameter/highlight_color = Color(0.3019608, 0.50980395, 0.7607843, 1)

[sub_resource type="Shader" id="LockSelectorHighlightShader"]
code = "shader_type canvas_item;

uniform float highlighted : hint_range(0.0, 1.0) = 0.0;
uniform vec4 highlight_color : source_color = vec4(0.3019608, 0.50980395, 0.7607843, 1.0);

void fragment() {
	vec4 source = texture(TEXTURE, UV) * COLOR;
	if (source.a > 0.0 && source.b > source.r * 1.3) {
		source.rgb = mix(source.rgb, highlight_color.rgb, highlighted);
	}
	COLOR = source;
}"

[sub_resource type="ShaderMaterial" id="LockSelectorHighlightMaterial"]
resource_local_to_scene = true
shader = SubResource("LockSelectorHighlightShader")
shader_parameter/highlighted = 0.0
shader_parameter/highlight_color = Color(0.3019608, 0.50980395, 0.7607843, 1)

