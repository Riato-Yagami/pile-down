[sub_resource type="Theme" id="PixelTheme"]
default_font = ExtResource("12")
default_font_size = 20

[sub_resource type="Shader" id="ClockProgressShader"]
code = "shader_type canvas_item;

uniform float progress : hint_range(0.0, 1.0) = 1.0;
uniform vec4 progress_color : source_color = vec4(0.302, 0.51, 0.761, 1.0);
uniform vec4 flash_color : source_color = vec4(0.878, 0.392, 0.333, 1.0);
uniform float flash_strength : hint_range(0.0, 1.0) = 0.0;

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	vec4 clock_color;
	bool green_key = source.g > 0.6 && source.g > source.r * 1.35 && source.g > source.b * 1.35;
	if (source.a > 0.0 && green_key) {
		float angle = atan(UV.y - 0.5, UV.x - 0.5);
		float clockwise_from_top = fract((angle + 1.57079632679) / 6.28318530718);
		clock_color = clockwise_from_top <= progress ? progress_color : vec4(0.8, 0.8, 0.8, source.a);
	} else {
		clock_color = source;
	}
	COLOR = mix(clock_color, vec4(flash_color.rgb, clock_color.a), flash_strength);
}"

