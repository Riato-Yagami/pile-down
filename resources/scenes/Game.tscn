resource_local_to_scene = true
shader = SubResource("ClockProgressShader")
shader_parameter/progress = 1.0
shader_parameter/progress_color = Color(0.302, 0.51, 0.761, 1)
shader_parameter/flash_color = Color(0.878, 0.392, 0.333, 1)
shader_parameter/flash_strength = 0.0

