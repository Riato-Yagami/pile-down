[sub_resource type="Shader" id="ProgressionButtonHighlightShader"]
code = "shader_type canvas_item;

uniform vec4 base_color : source_color = vec4(0.302, 0.51, 0.761, 1.0);
uniform vec4 highlight_color : source_color = vec4(0.3019608, 0.50980395, 0.7607843, 1.0);

void fragment() {
	vec4 texture_color = texture(TEXTURE, UV);
	vec4 source = texture_color * COLOR;
	bool base_fill_pixel = (
		texture_color.a > 0.0
		&& distance(texture_color.rgb, base_color.rgb) < 0.01
	);
	if (base_fill_pixel) {
		source.rgb = highlight_color.rgb;
	}
	COLOR = source;
}"

[sub_resource type="ShaderMaterial" id="FontButtonHighlightMaterial"]
resource_local_to_scene = true
shader = SubResource("ProgressionButtonHighlightShader")
shader_parameter/base_color = Color(0.302, 0.51, 0.761, 1)
shader_parameter/highlight_color = Color(0.427, 0.655, 0.898, 1)

[sub_resource type="Shader" id="FontPreviewTileShader"]
code = "shader_type canvas_item;

uniform vec4 tile_color : source_color = vec4(0.302, 0.51, 0.761, 1.0);

void fragment() {
	vec4 source = texture(TEXTURE, UV);
	bool is_green = source.g > 0.6 && source.g > source.r * 1.35 && source.g > source.b * 1.35;
	COLOR = is_green ? vec4(tile_color.rgb, source.a * tile_color.a) : source;
}
"

[sub_resource type="ShaderMaterial" id="FontPreviewTileMaterial"]
resource_local_to_scene = true
shader = SubResource("FontPreviewTileShader")
shader_parameter/tile_color = Color(0.302, 0.51, 0.761, 1)

