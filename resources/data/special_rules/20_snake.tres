[ext_resource type="Script" uid="uid://npyanr3hwunc" path="res://resources/scripts/special_rules/SpecialRuleData.gd" id="1"]

[resource]
script = ExtResource("1")
title = "SNAKE"
subtitle = "Feed the tail."
description = "Piles chase hand tiles on an invisible grid. Eaten tiles respawn elsewhere and the last active pile regains one point, up to its round maximum."
incompatible_rules = Array[StringName]([&"merry_go_stack", &"shaking_piles", &"wavy_baby", &"free_range_cards", &"musical_stacks", &"pile_up", &"floor_is_lava"])
minimum_round = 8
id = &"snake"
